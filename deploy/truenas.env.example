# Copiá este archivo a "truenas.env" (sin ".example") en esta misma carpeta,
# completá los valores reales, y guardalo. "truenas.env" ya está en
# .gitignore -- nunca se commitea, y nunca hace falta pegarlo en el chat:
# se lee directo del disco.
#
# La clave privada NO va acá adentro como texto. Dejala donde ya tengas tus
# claves SSH (típicamente ~/.ssh/) con sus permisos normales, y poné acá
# solo la RUTA a ese archivo.

# --- Conexión SSH a TrueNAS ------------------------------------------------

SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_KEY_PATH=

# --- Opcional: host del nginx que hace de reverse proxy delante de Emby ----
# Solo hace falta si vas a usar deploy/nginx-ssh.sh (p. ej. para instalar
# deploy/nginx/emby-cors-proxy.conf). Misma idea: la clave privada queda en
# ~/.ssh/, acá va solo la ruta. Las variables NGINX_HOST_CONTAINER_* y
# NGINX_HOST_REMOTE_WEB_TERMINAL_URL son informativas (por si nginx corre en
# un container o se administra por web); pueden quedar vacías.

NGINX_HOST_REMOTE_HOST=
NGINX_HOST_REMOTE_SSH_PORT=22
NGINX_HOST_REMOTE_SSH_USER=
NGINX_HOST_REMOTE_SSH_KEY=
NGINX_HOST_REMOTE_SESSION_NAME=
NGINX_HOST_CONTAINER_NAME=
NGINX_HOST_CONTAINER_EXEC_PATH=
NGINX_HOST_REMOTE_WEB_TERMINAL_URL=

# --- Opcional: para saltear la auto-detección del instalador ---------------
# Si los dejás vacíos, se usa --discover-only la primera vez y de ahí en
# más queda cacheado en .emby-installer-state (ver README del proyecto).

EMBY_CONTAINER=
EMBY_URL=

# --- Opcional: API keys, SOLO si querés bootstrapear el wizard sin ---------
# --- interacción (--silent). Si preferís, corré el wizard interactivo la --
# --- primera vez por SSH y dejá esto vacío -- después no hace falta. ------

EMBY_API_KEY=
TMDB_API_KEY=
MDBLIST_API_KEY=
KINOPOISK_API_KEY=
